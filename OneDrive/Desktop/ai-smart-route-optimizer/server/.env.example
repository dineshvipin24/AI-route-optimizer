PORT=5000

# OpenRouteService API key — get free at https://openrouteservice.org/dev/#/signup
# Without this, the app runs in SIMULATION mode (still works for demo!)
ORS_API_KEY=your_ors_api_key_here

# OpenWeatherMap API key — get free at https://openweathermap.org/api
# Without this, the app runs in SIMULATION mode (still works for demo!)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Gemini API Key - Get free at https://aistudio.google.com/
# Leave empty or replace with your own key. If missing, will fallback to a simulated LLM.
GEMINI_API_KEY=your_gemini_api_key_here
